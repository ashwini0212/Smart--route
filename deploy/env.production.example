# Copy to .env in the repository root ON THE SERVER and fill in every "CHANGE-ME".
# Never commit the filled-in file; .env is in .gitignore.
# Generate secrets with:  openssl rand -base64 48

# --- Public address ---
# The host name Caddy requests a certificate for. With no domain of your own, use the server's public IP
# with dashes on sslip.io, e.g. 203-0-113-7.sslip.io (it resolves to 203.0.113.7).
SITE_ADDRESS=CHANGE-ME.sslip.io
# The same address as a URL. It is the only origin the backend accepts for cross-origin requests.
PUBLIC_URL=https://CHANGE-ME.sslip.io

# --- PostgreSQL (only reachable inside the Docker network) ---
POSTGRES_DB=smartroute
POSTGRES_USER=smartroute
POSTGRES_PASSWORD=CHANGE-ME

# --- Security ---
JWT_SECRET=CHANGE-ME-at-least-32-bytes
# One password shared by every demo login, admin@smartroute.local included. Anyone who has it can change
# data, so give it only to people you trust with that. Leave empty to create no demo logins.
DEMO_USER_PASSWORD=CHANGE-ME-at-least-12-chars
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "seed" loads the fictional demo dataset on the first start (empty database only).
SPRING_PROFILES_ACTIVE=seed

# --- Events ---
EVENTS_RELAY_INTERVAL=500ms

# --- [SIMULATION] ---
# Moving drivers and random slow road segments, so the live map has something to show. Everything they
# generate is labelled SIMULATION in the API and the UI. Set to false for a site with only real input.
SIMULATE_DRIVERS=true
SIMULATE_TRAFFIC=false

# --- Optional assistant (paid API, off by default) ---
ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium

# --- Logs ---
LOGGING_STRUCTURED_FORMAT_CONSOLE=
