# Copy to .env and change the values. Never commit .env.

# PostgreSQL
POSTGRES_DB=smartroute
POSTGRES_USER=smartroute
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka (port for clients running on your machine; containers use kafka:9092)
KAFKA_EXTERNAL_PORT=9094

# Application ports on your machine
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Spring profiles for the backend container. "seed" fills an empty database with fictional demo data.
SPRING_PROFILES_ACTIVE=seed

# --- Security (Phase 5) ---
# HMAC key for access tokens, at least 32 bytes. Generate your own: openssl rand -base64 48
# The app logs a warning while this example value is in use.
JWT_SECRET=change-me-local-only-jwt-secret-0123456789
# Password for the demo logins created by the seed profile (admin@, dispatcher@, viewer@, driver1@, driver2@
# smartroute.local). At least 12 characters. Leave empty to create no demo logins.
DEMO_USER_PASSWORD=change-me-demo-password
# Optional: create a first admin on an empty database (when not using the seed profile).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Domain events (Phase 9) ---
# How often the outbox relay looks for unpublished events. This is also the typical delay between a change
# and its event being readable: measured 471 ms (p50) at 500ms and 54 ms at 50ms, see
# docs/benchmarks/phase-9-events.txt. Smaller means more empty queries against the database.
EVENTS_RELAY_INTERVAL=500ms

# --- Live tracking and simulators (Phase 10) ---
# [SIMULATION] Both are off by default and generate data that nobody observed: driver positions moving
# along real roads at a flat speed, and random road segments slowed down. Turn them on for a demo, never
# to produce numbers. Everything they generate is labelled; see GET /api/simulation/status.
SIMULATE_DRIVERS=false
SIMULATE_TRAFFIC=false

# --- Observability (Phase 12) ---
# How often the domain gauges (orders waiting, deliveries active, drivers available, outbox depth) are
# recomputed. They are sampled on this timer rather than inside the Prometheus scrape, so the database
# cost does not depend on how many things are scraping. Gauges can be this stale.
METRICS_SAMPLE_INTERVAL=30s
# Leave empty for human-readable console logs. Set to `ecs`, `logstash` or `gelf` for structured JSON
# (one object per line, with trace.id and user.id), which is what a log collector wants.
LOGGING_STRUCTURED_FORMAT_CONSOLE=

# --- API documentation (Phase 15) ---
# true serves /swagger-ui.html and /v3/api-docs to anyone who can reach the port; false makes them
# admin-only. True here because the stack binds to localhost and the docs are how you learn the API.
# Set it to false anywhere a stranger can reach the port: the document is a map of every endpoint and DTO.
API_DOCS_PUBLIC=true

# --- Optional assistant (Phase 14) ---
# The one feature that calls a paid API, and the only one that is off by default. It needs BOTH the flag and
# a key: with the flag on and no key, the API answers 503 naming the missing setting rather than failing on
# the first question. The assistant can only read — it has six read-only tools and no tool that writes, which
# the architecture test enforces, not just the prompt.
ASSISTANT_ENABLED=false
# Never commit a real key. This file is the example; .env is in .gitignore.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# How hard the model thinks, and so what one question costs: low, medium, high, xhigh, max.
ASSISTANT_EFFORT=medium
# Paid round trips allowed per question before the model must answer with what it has.
ASSISTANT_MAX_TOOL_ROUNDS=6
