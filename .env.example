# Copy to .env and change the values. Never commit .env.

# PostgreSQL
POSTGRES_DB=smartroute
POSTGRES_USER=smartroute
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka (port for clients running on your machine; containers use kafka:9092)
KAFKA_EXTERNAL_PORT=9094

# Application ports on your machine
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Spring profiles for the backend container. "seed" fills an empty database with fictional demo data.
SPRING_PROFILES_ACTIVE=seed

# --- Security (Phase 5) ---
# HMAC key for access tokens, at least 32 bytes. Generate your own: openssl rand -base64 48
# The app logs a warning while this example value is in use.
JWT_SECRET=change-me-local-only-jwt-secret-0123456789
# Password for the demo logins created by the seed profile (admin@, dispatcher@, viewer@, driver1@, driver2@
# smartroute.local). At least 12 characters. Leave empty to create no demo logins.
DEMO_USER_PASSWORD=change-me-demo-password
# Optional: create a first admin on an empty database (when not using the seed profile).
ADMIN_EMAIL=
ADMIN_PASSWORD=
